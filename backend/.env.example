# Tabela canônica (o que é obrigatório, defaults e onde cada uma é lida):
# docs/setup-e-deploy.md. Sem MONGODB_URI o app sobe, mas as rotas de banco
# respondem 503.

# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
MONGODB_DATABASE=luxus_brecho_db

# Tunings do driver Mongo — os defaults abaixo são os do código; descomente
# apenas se precisar ajustar.
# MONGO_SERVER_SELECTION_MS=15000
# MONGO_CONNECT_TIMEOUT_MS=20000
# MONGO_SOCKET_TIMEOUT_MS=20000
# MONGO_MAX_POOL_SIZE=50
# MONGO_APPNAME=Luxus-Brecho-Backend

# ========== FLASK ==========
FLASK_DEBUG=True
FRONTEND_ORIGIN=http://localhost:5173

# Host/porta do servidor. Em dev, run.py prefere o network-config.json da raiz
# (gerado por `npm run dev`) e só cai nestas variáveis se o arquivo não existir.
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000

# Rótulo informativo devolvido por GET /api/health.
# FLASK_ENV=production

# Assina a sessão do Flask (não confundir com JWT_SECRET_KEY, que assina os
# tokens). O default 'dev-secret-key' é inseguro — defina em produção.
# SECRET_KEY=troque-em-producao

# Limite do corpo da requisição em bytes (default 16777216 = 16MB). Um upload
# acima disso é rejeitado com 413.
# MAX_CONTENT_LENGTH=16777216

# ========== RATE LIMIT ==========
# Storage dos contadores de rate limit. O padrão memory:// NÃO compartilha
# contadores entre workers e zera a cada restart (fraco em produção/serverless).
# Aponte para um storage compartilhado em produção, ex.: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# ========== JWT (mude em produção!) ==========
# O algoritmo é HS256, fixo no código: HS384/HS512 não trariam ganho aqui e
# RS256 exigiria par de chaves em vez deste secret. Não é configurável por env.
JWT_SECRET_KEY=sua-chave-secreta-32-chars-minimo

# ========== ADMIN INICIAL ==========
# Sem estas variáveis nenhum admin é semeado no primeiro boot (não há senha padrão).
# A senha precisa atender à política (mín. 6 caracteres, com ao menos uma letra e um número).
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=Administrador

# ========== SUPABASE STORAGE ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_BUCKET=product-images

# Credenciais de service role usadas SÓ como retry: quando um upload é barrado
# pela row-level security do bucket, o serviço faz sign-in com estas e tenta de
# novo. Sem elas, esse retry falha e o upload bloqueado por RLS não se recupera.
SUPABASE_SERVICE_ROLE_EMAIL=service-role@seudominio.com
SUPABASE_SERVICE_ROLE_KEY=senha-do-usuario-service-role

# ========== EMAIL SMTP ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
FROM_EMAIL=seu-email@gmail.com
FROM_NAME=Luxus Brechó

# ========== URLS ==========
# Base dos links que o backend monta nos e-mails (confirmação de conta, etc.).
# A precedência é: PRODUCTION_URL > APP_URL > network-config.json da raiz >
# http://localhost:5000. Em produção defina PRODUCTION_URL, senão os links do
# e-mail apontam para a máquina de quem enviou.
# PRODUCTION_URL=https://api.seudominio.com
# APP_URL=http://192.168.0.10:5000

# Base dos links que apontam para o frontend web (ex.: /redefinir-senha/<token>).
FRONTEND_URL=http://localhost:5173