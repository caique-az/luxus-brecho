# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
MONGODB_DATABASE=luxus_brecho_db

# ========== FLASK ==========
FLASK_DEBUG=True
FRONTEND_ORIGIN=http://localhost:5173

# ========== RATE LIMIT ==========
# Storage dos contadores de rate limit. O padrão memory:// NÃO compartilha
# contadores entre workers e zera a cada restart (fraco em produção/serverless).
# Aponte para um storage compartilhado em produção, ex.: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# ========== JWT (mude em produção!) ==========
# O algoritmo é HS256, fixo no código: HS384/HS512 não trariam ganho aqui e
# RS256 exigiria par de chaves em vez deste secret. Não é configurável por env.
JWT_SECRET_KEY=sua-chave-secreta-32-chars-minimo

# ========== ADMIN INICIAL ==========
# Sem estas variáveis nenhum admin é semeado no primeiro boot (não há senha padrão).
# A senha precisa atender à política (mín. 6 caracteres, com ao menos uma letra e um número).
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=Administrador

# ========== SUPABASE STORAGE ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_BUCKET=product-images

# ========== EMAIL SMTP ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
FROM_EMAIL=seu-email@gmail.com
FROM_NAME=Luxus Brechó

# ========== URLS ==========
FRONTEND_URL=http://localhost:5173